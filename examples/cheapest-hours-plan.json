    "market": "DE",
    "hours": 48,
    "mode": "mixed",
    "resolution": "15m",
    "currency": "auto",
    "priceMode": "base",
    "postalCode": "",
    "x": 390,
    "y": 100,
    "wires": [["epf_plan_planner"]]
  },
  {
    "id": "epf_plan_planner",
    "type": "energypriceforecast-planner",
    "z": "epf_plan_tab",
    "name": "4 cheapest of every 24 h",
    "planType": "repeating",
    "selectedHours": 4,
    "blockHours": 24,
    "startDay": 1,
    "startHour": 0,
    "timeZone": "auto",
    "emitMode": "every",
    "emitInitial": false,
    "x": 660,
    "y": 100,
    "wires": [["epf_plan_on"], ["epf_plan_off"]]
  },
  {
    "id": "epf_plan_on",
    "type": "debug",
